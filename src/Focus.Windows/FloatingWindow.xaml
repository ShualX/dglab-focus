<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DglabFocus.Windows.FloatingWindow" Title="郊狼自习室悬浮球" Width="80" Height="80" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" Loaded="OnLoaded">
  <Grid>
    <Border x:Name="Ball" CornerRadius="38" Margin="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="2" MouseLeftButtonDown="DragBall" KeyDown="BallKeyDown" Focusable="True" Cursor="Hand" ToolTip="点击展开，拖动移动；Ctrl+Alt+F10 立即暂停" AutomationProperties.Name="专注悬浮球，按回车展开">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="◉" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" FontSize="21"/>
        <TextBlock x:Name="BallTimeLabel" Text="50:00" FontSize="12" FontFamily="Bahnschrift" HorizontalAlignment="Center" Margin="0,3,0,0"/>
      </StackPanel>
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem Header="打开控制台" Click="OpenClick"/>
          <MenuItem Header="立即暂停" Click="StopClick"/>
          <MenuItem Header="展开悬浮球" Click="ExpandClick"/>
        </ContextMenu>
      </Border.ContextMenu>
    </Border>
    <Border x:Name="ControlsPanel" Visibility="Collapsed" CornerRadius="18" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid MouseLeftButtonDown="DragHeader">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border CornerRadius="20" Width="36" Height="36" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
            <TextBlock Text="◉" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" FontSize="20"/>
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="TimeLabel" Text="50:00" FontFamily="Bahnschrift" FontSize="23"/>
            <TextBlock x:Name="StateLabel" Text="等待开始" Style="{StaticResource Caption}" FontSize="11"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Content="打开" Click="OpenClick" MinHeight="32" Padding="8,5" AutomationProperties.Name="打开专注控制台"/>
            <Button Content="⌃" Click="CollapseClick" MinHeight="32" Padding="8,5" Margin="5,0,0,0" AutomationProperties.Name="收起悬浮球"/>
          </StackPanel>
        </Grid>
        <ProgressBar x:Name="Progress" Grid.Row="1" Height="3" Foreground="{DynamicResource Accent}" Background="{DynamicResource Raised}" BorderThickness="0" Margin="0,12,0,10" AutomationProperties.Name="当前曲线强度"/>
        <DockPanel Grid.Row="2">
          <Button x:Name="CheckInButton" Content="我在学习" DockPanel.Dock="Right" Click="CheckInClick" Visibility="Collapsed" Padding="8,5" MinHeight="32"/>
          <TextBlock x:Name="MessageLabel" Text="每次会话可临时放行 1 个域名" Style="{StaticResource Caption}" FontSize="11" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Grid Grid.Row="3" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Button x:Name="ExitButton" Content="申请退出" Click="ExitClick" MinHeight="34" Padding="8,7" Margin="0,0,5,0"/>
          <Button Grid.Column="1" Content="立即暂停" Foreground="{DynamicResource Danger}" Click="StopClick" MinHeight="34" Padding="8,7" Margin="5,0,0,0"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
