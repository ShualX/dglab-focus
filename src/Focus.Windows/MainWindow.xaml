<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DglabFocus.Windows" x:Class="DglabFocus.Windows.MainWindow" Title="郊狼自习室 · dglab-focus" Width="1180" Height="830" MinWidth="920" MinHeight="680" WindowStartupLocation="CenterScreen" Closing="WindowClosing" SourceInitialized="WindowInitialized">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="会话(_S)">
        <MenuItem Header="开始 / 继续" Click="StartClick"/>
        <MenuItem Header="申请退出（等待 5 分钟）" Click="ExitClick"/>
        <MenuItem Header="取消退出" Click="CancelExitClick"/>
        <Separator/>
        <MenuItem Header="立即暂停" InputGestureText="Ctrl+Alt+F12" Click="EmergencyClick"/>
      </MenuItem>
      <MenuItem Header="视图(_V)">
        <MenuItem Header="显示悬浮球" Click="FloatClick"/>
        <MenuItem Header="界面放大" InputGestureText="Ctrl++" Click="ZoomInClick"/>
        <MenuItem Header="界面缩小" InputGestureText="Ctrl+-" Click="ZoomOutClick"/>
      </MenuItem>
      <MenuItem Header="帮助(_H)">
        <MenuItem Header="使用说明" Click="HelpClick"/>
        <MenuItem Header="GitHub 仓库" Click="GithubClick"/>
      </MenuItem>
    </Menu>
    <Grid x:Name="RootGrid" Background="{DynamicResource Bg}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
        <DockPanel Margin="18,26,18,20">
          <StackPanel DockPanel.Dock="Top" Margin="12,0,0,32">
            <TextBlock Text="COYOTE" FontFamily="Bahnschrift Condensed" FontSize="29" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
            <TextBlock Text="郊狼自习室" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,4"/>
            <TextBlock Text="STUDY ROOM" Style="{StaticResource Caption}" FontFamily="Bahnschrift" FontSize="11"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="12,12,0,0">
            <TextBlock Text="WINDOWS · v0.1.0" Style="{StaticResource Caption}" FontFamily="Bahnschrift"/>
            <TextBlock Text="独立开源项目 / 模拟预览版" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel>
            <Button x:Name="NavFocus" Content="◉   专注控制台" Style="{StaticResource Nav}" Tag="FocusPage" Click="NavigateClick"/>
            <Button Content="☷   允许使用" Style="{StaticResource Nav}" Tag="RulesPage" Click="NavigateClick"/>
            <Button Content="◷   会话设置" Style="{StaticResource Nav}" Tag="SettingsPage" Click="NavigateClick"/>
            <Button Content="⌁   设备与浏览器" Style="{StaticResource Nav}" Tag="DevicePage" Click="NavigateClick"/>
            <Button Content="≡   会话记录" Style="{StaticResource Nav}" Tag="HistoryPage" Click="NavigateClick"/>
            <Border Height="1" Background="{DynamicResource Line}" Margin="10,20"/>
            <Button Content="立即暂停" Foreground="{DynamicResource Danger}" Click="EmergencyClick" ToolTip="暂停会话与模拟反馈，不受退出倒计时限制"/>
            <TextBlock x:Name="HotkeyLabel" Text="Ctrl + Alt + F12" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="30,24,30,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="专注控制台" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="PageSubtitle" Text="把注意力留在当前这一段。" Style="{StaticResource Caption}" Margin="0,7,0,0"/>
          </StackPanel>
          <Border Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="14,8" VerticalAlignment="Top">
            <TextBlock Text="●  模拟反馈 · 无设备输出" Foreground="{DynamicResource Accent}" FontSize="12"/>
          </Border>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
          <Grid x:Name="PageHost">
            <Grid x:Name="FocusPage">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="20">
                  <StackPanel>
                    <Grid>
                      <TextBlock Text="本次专注" FontWeight="SemiBold"/>
                      <TextBlock x:Name="ModeLabel" Text="电脑复习" HorizontalAlignment="Right" Style="{StaticResource Caption}"/>
                    </Grid>
                    <local:FocusDial x:Name="Dial" Height="328" MinWidth="280" AutomationProperties.Name="专注计时盘"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                      <Button Content="25 分钟" Click="PresetClick" Tag="25" Padding="12,6" MinHeight="34"/>
                      <Button Content="50 分钟" Click="PresetClick" Tag="50" Padding="12,6" MinHeight="34" Margin="8,0"/>
                      <Button Content="无限" Click="PresetClick" Tag="0" Padding="12,6" MinHeight="34"/>
                    </StackPanel>
                    <Button x:Name="StartButton" Content="开始专注" Style="{StaticResource Primary}" Click="StartClick" MinHeight="48" FontSize="16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                      <Button x:Name="ExitButton" Content="申请退出" Click="ExitClick" Padding="14,8"/>
                      <Button x:Name="CancelExitButton" Content="取消退出" Click="CancelExitClick" Visibility="Collapsed"/>
                      <Button Content="显示悬浮球" Click="FloatClick" Margin="10,0,0,0" Padding="14,8"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <StackPanel Grid.Column="1">
                  <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                      <TextBlock Text="当前检测" Style="{StaticResource SectionTitle}"/>
                      <TextBlock x:Name="CurrentAppLabel" Text="等待前台窗口" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="50"/>
                      <TextBlock x:Name="CurrentUrlLabel" Text="网页地址仅在本机用于规则匹配" Style="{StaticResource Caption}" Margin="0,8,0,14" TextTrimming="CharacterEllipsis" MaxHeight="48"/>
                      <Border Background="{DynamicResource Raised}" CornerRadius="8" Padding="12">
                        <TextBlock x:Name="DetectionLabel" Text="尚未开始" Foreground="{DynamicResource Accent}"/>
                      </Border>
                      <TextBlock x:Name="ReasonLabel" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                      <Grid>
                        <TextBlock Text="累计分心"/>
                        <TextBlock x:Name="DebtLabel" Text="0 秒" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                      </Grid>
                      <ProgressBar x:Name="DebtBar" Height="4" Margin="0,14,0,10" Foreground="{DynamicResource Accent}" Background="{DynamicResource Raised}" BorderThickness="0" Maximum="60"/>
                      <TextBlock x:Name="ThresholdLabel" Text="提醒线 60 秒 / 持续专注后逐渐消除" Style="{StaticResource Caption}" FontSize="12"/>
                      <Border Height="1" Background="{DynamicResource Line}" Margin="0,18"/>
                      <Grid>
                        <TextBlock Text="最近一小时" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="IncidentLabel" Text="0 次分心" HorizontalAlignment="Right"/>
                      </Grid>
                      <TextBlock x:Name="FeedbackLabel" Text="反馈待命" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
              <Border x:Name="CheckInPanel" Grid.Row="1" Style="{StaticResource Card}" BorderBrush="{DynamicResource Accent}" Margin="0,16,0,0" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="还在学习吗？" FontWeight="SemiBold"/>
                    <TextBlock Text="阅读和纸笔复习可能没有键鼠输入。未确认时只作屏幕提醒。" Style="{StaticResource Caption}" Margin="0,6,16,0"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="我在学习" Style="{StaticResource Primary}" Click="CheckInClick"/>
                </Grid>
              </Border>
              <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="临时查询" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TemporaryLabel" Text="每次会话可临时新增 1 个域名，仅本次有效。" Style="{StaticResource Caption}" Margin="0,6,0,12"/>
                    <TextBox x:Name="TemporaryInput" AutomationProperties.Name="临时放行域名" MaxLength="2048" ToolTip="例如 docs.example.com，只允许这个主机，不自动包含子域名"/>
                  </StackPanel>
                  <Button x:Name="TemporaryButton" Grid.Column="1" Content="加入允许" Margin="14,0,0,0" VerticalAlignment="Bottom" Click="TemporaryClick"/>
                </Grid>
              </Border>
            </Grid>
            <StackPanel x:Name="RulesPage" Visibility="Collapsed">
              <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="允许使用的软件" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="选取程序的 .exe 文件，按完整路径识别。开始后，规则保持到会话结束。" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
                  <Button Content="选取软件…" Click="AddAppClick" HorizontalAlignment="Left" x:Name="AddAppButton"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="浏览器高级设置" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="同时支持 Chrome 和 Edge，需要安装随附扩展。配置网页规则后，浏览器的软件规则不会绕过网页限制。" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
                  <Grid x:Name="BrowserRuleEditor">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150"/>
                      <ColumnDefinition/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="RuleKindBox" SelectedIndex="0" AutomationProperties.Name="网页规则类型">
                      <ComboBoxItem Content="整个域名"/>
                      <ComboBoxItem Content="仅此页面"/>
                      <ComboBoxItem Content="页面路径"/>
                    </ComboBox>
                    <TextBox x:Name="RuleInput" Grid.Column="1" Margin="12,0" MaxLength="6000" AutomationProperties.Name="允许的网址或域名"/>
                    <Button Grid.Column="2" Content="添加规则" Click="AddWebClick"/>
                  </Grid>
                  <CheckBox x:Name="SubdomainsBox" Content="域名规则包含子域名" Margin="0,10,0,0"/>
                  <TextBlock Text="具体页面保留查询参数和 # 后的内容。路径规则按路径边界匹配，不包含其他域名。" Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="RuleLockLabel" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
              <ListBox x:Name="RuleList" MaxHeight="420">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="110"/>
                          <ColumnDefinition/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Display}" Margin="8,0,12,0" ToolTip="{Binding Value}"/>
                        <Button Grid.Column="2" Content="移除" Click="RemoveRuleClick" Tag="{Binding}" Padding="12,6" MinHeight="34"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
            <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
              <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="会话节奏" Style="{StaticResource SectionTitle}"/>
                  <StackPanel x:Name="SessionSettingsEditor">
                    <TextBlock Text="学习方式" Style="{StaticResource Caption}" Margin="0,0,0,7"/>
                    <ComboBox x:Name="ModeBox" SelectedIndex="0" AutomationProperties.Name="学习方式">
                      <ComboBoxItem Content="电脑复习 · 空闲时请求确认"/>
                      <ComboBoxItem Content="阅读 / 网课 · 定期请求确认"/>
                      <ComboBoxItem Content="纸笔复习 · 按时确认，暂停前台判断"/>
                    </ComboBox>
                    <UniformGrid Columns="3" Margin="0,18,0,0">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="专注分钟 · 0 为无限" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="FocusMinutesBox" Text="50" Margin="0,7,0,0" AutomationProperties.Name="专注分钟"/>
                      </StackPanel>
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="休息分钟 · 0 为不休息" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="RestMinutesBox" Text="10" Margin="0,7,0,0" AutomationProperties.Name="休息分钟"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="阅读 / 纸笔确认间隔（分）" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="CheckInMinutesBox" Text="15" Margin="0,7,0,0" AutomationProperties.Name="学习确认间隔分钟"/>
                      </StackPanel>
                    </UniformGrid>
                    <CheckBox x:Name="RepeatBox" Content="休息结束后开始下一轮专注（仍属同一会话）" Margin="0,12,0,0"/>
                    <UniformGrid Columns="3" Margin="0,16,0,0">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="切换宽限（秒）" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="GraceBox" Text="10" Margin="0,7,0,0" AutomationProperties.Name="切换宽限秒"/>
                      </StackPanel>
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="累计提醒线（秒）" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="ThresholdBox" Text="60" Margin="0,7,0,0" AutomationProperties.Name="累计分心提醒秒"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="无操作确认（秒）" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="IdleBox" Text="180" Margin="0,7,0,0" AutomationProperties.Name="空闲确认秒"/>
                      </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,16,0,0">
                      <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="连续专注多久后恢复（秒）" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="RecoveryDelayBox" Text="120" Margin="0,7,0,0" AutomationProperties.Name="恢复等待秒"/>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="每专注 1 秒消除的分心秒数" Style="{StaticResource Caption}"/>
                        <TextBox x:Name="RecoveryRateBox" Text="0.5" Margin="0,7,0,0" AutomationProperties.Name="恢复速度"/>
                      </StackPanel>
                    </UniformGrid>
                    <Button Content="保存会话设置" Click="SaveSettingsClick" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                  </StackPanel>
                  <TextBlock Text="设置在下一次会话生效。休息、继续、取消退出和重新启动软件均不补充临时域名名额。" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="反馈与显示" Style="{StaticResource SectionTitle}"/>
                  <CheckBox x:Name="SoundBox" Content="分心达到提醒线时播放提示音（默认关闭）" Click="PreferencesClick"/>
                  <CheckBox x:Name="ReducedMotionBox" Content="减少动态效果" Click="PreferencesClick"/>
                  <TextBlock Text="提醒始终包含文字。系统关闭动画或启用高对比度时，软件会相应调整。" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                  <Button Content="开始一次休息" Click="BreakClick" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel x:Name="DevicePage" Visibility="Collapsed">
              <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="Chrome / Edge 连接" Style="{StaticResource SectionTitle}"/>
                  <TextBlock x:Name="BridgeLabel" Text="等待扩展连接"/>
                  <TextBlock Text="在浏览器的扩展管理页开启开发者模式，加载下载包中的 extension 文件夹。在扩展弹窗中粘贴本机配对码。" Style="{StaticResource Caption}" Margin="0,10,0,16"/>
                  <Button Content="复制本机配对码" Click="CopyTokenClick" HorizontalAlignment="Left"/>
                  <TextBlock Text="扩展只向 127.0.0.1 发送当前窗口的活动页地址，不采集页面正文、密码或键入内容。完整地址仅在内存匹配，记录不保存浏览历史。" Style="{StaticResource Caption}" Margin="0,14,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="DG-LAB 4 App · 连接预览" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="当前版本仅完成配对与设备发现，不发送电刺激指令。实际主机和 App 版本将在设备到货后验证。" Foreground="{DynamicResource Accent}" Margin="0,0,0,14"/>
                  <TextBlock x:Name="DeviceStatusLabel" Text="未连接 · 模拟反馈可独立运行" Style="{StaticResource Caption}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="DeviceConnectButton" Content="生成配对二维码" Click="DeviceConnectClick"/>
                    <Button Content="断开连接" Click="DeviceDisconnectClick" Margin="12,0,0,0"/>
                  </StackPanel>
                  <Image x:Name="PairingQr" Width="220" Height="220" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,20,0,0" Visibility="Collapsed" AutomationProperties.Name="DG-LAB App 配对二维码"/>
                  <TextBlock Text="连接预览使用官方 WebSocket 中继，手机 App 与中继交换配对和设备状态。专注记录与网页地址不发送到中继。" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel x:Name="HistoryPage" Visibility="Collapsed">
              <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="本机记录" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="保留最近 200 条会话事件。记录时间、规则变化和提醒，不记录键入内容或浏览历史。" Style="{StaticResource Caption}"/>
                </StackPanel>
              </Border>
              <ListBox x:Name="HistoryList">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="88"/>
                          <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding At, StringFormat=HH:mm:ss}" Style="{StaticResource Caption}" FontFamily="Consolas"/>
                        <TextBlock Grid.Column="1" Text="{Binding Message}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" x:Name="NoticePanel" Background="{DynamicResource Raised}" CornerRadius="9" Padding="14,10" Margin="0,14,0,0">
          <TextBlock x:Name="NoticeLabel" Text="先添加允许规则，再开始专注。设备未到货也可以验证完整计时流程。" FontSize="12" Foreground="{DynamicResource Muted}"/>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
