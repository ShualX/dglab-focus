<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DglabFocus</AssemblyName>
    <RootNamespace>DglabFocus.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/focus.ico</ApplicationIcon>
    <Description>郊狼自习室 Windows 专注工具（模拟预览版）</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    <ProjectReference Include="../Focus.Core/Focus.Core.csproj"/>
    <PackageReference Include="QRCoder" Version="1.6.0"/>
    <Resource Include="Assets/focus.ico"/>
  </ItemGroup>
</Project>
